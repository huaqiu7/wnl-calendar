    background-color: #fff;
    border-radius: 0;
    position: static;
}

button::after {
    width: 0;
    height: 0;
}

.button-hover {
    background-color: #fff;
}

.btn {
    flex: 1;
    text-align: center;
    line-height: 100rpx;
    font-size: 34rpx;
    border: none;
    z-index: 999;
}

.left-btn {
    border-right: 2rpx solid #e5e5e5;
    border-bottom-left-radius: 8rpx;
    color: #333;
}

.right-btn {
    border-bottom-right-radius: 8rpx;
    color: #d03f3f;
}

.close-content {
    position: absolute;
    top: 15rpx;
    right: 15rpx;
    padding: 15rpx;
}

.close-icon {
    width: 20rpx;
    height: 20rpx;
    background: url("https://mobile.51wnl.com/temporary/dailysign/close-icon@2x.png") no-repeat 50%;
    background-size: cover;
}

.big-btn {
    margin: 60rpx 30rpx 0;
    -webkit-box-pack: space-between;
    justify-content: space-between;
}

.new-btn {
    width: 326rpx;
    height: 80rpx;
    border-radius: 8rpx;
    background-color: #d0aa60;
    font-size: 17px;
    line-height: 80rpx;
    text-align: center;
    color: #fff;
}

.launch-btn {
    width: 96rpx;
    height: 96rpx;
    position: fixed;
    top: 25rpx;
    right: 25rpx;
    padding: 0rpx;
    line-height: 70rpx;
    border-radius: 48rpx;
    background: transparent;
}

.out_view {
    position: relative;
}

.back_index_img {
    position: absolute;
    left: 40rpx;
    top: 8rpx;
    width: 174rpx;
    height: 64rpx;
}

.back_index_img.nottoday {
    top: -6rpx;
}

@media screen and (min-width:310px) and (max-width:359px) {
    .desc {
        margin-top: 20rpx;
    }
}

@media (-webkit-min-device-pixel-ratio:3),(min-device-pixel-ratio:3) {
    .close-icon {
        background: url("https://mobile.51wnl.com/temporary/dailysign/close-icon@3x.png") no-repeat 50%;
        background-size: cover;
    }

    .switch-icon {
        background: url("https://mobile.51wnl.com/temporary/dailysign/change-icon@3x.png") no-repeat 50%;
        background-size: cover;
    }

    .today-icon {
        background: url("https://mobile.51wnl.com/temporary/dailysign/today-icon@3x.png") no-repeat 50%;
        background-size: cover;
    }

    .pop-content {
        background: url("https://mobile.51wnl.com/temporary/dailysign/days-icon@3x.png") no-repeat 50%;
        background-size: 228rpx 72rpx;
    }
}