<template name="information">
    <view catchtap="toWebPage" data-did="{{content.detailID}}" data-dk="{{dateKey}}">
        <view class="inf-text">{{content.title}}</view>
        <view class="inf-imggroup">
            <image class="inf-pic" mode="widthFix" src="{{content.imgs[0]}}"></image>
            <image class="center-pic" mode="widthFix" src="{{content.imgs[1]}}"></image>
            <image class="inf-pic" mode="widthFix" src="{{content.imgs[2]}}"></image>
        </view>
    </view>
</template>
<template name="style5Temp">
    <view class="daily-sign style6">
        <view class="temp-box">
            <view class="inside-content-temp">
                <image mode="aspectFill" src="{{item.largeImage}}" style="position:absolute;width:100%;height:100%"></image>
                <view class="style6-content0">
                    <view class="style6-content">
                        <view>
                            <view class="date-num">{{item.day}}</view>
                            <view class="enmw">
                                <view style="font-size:30rpx">
                                    <text style="margin-right:10rpx" wx:if="{{item.festival}}">{{item.festival}}</text>
                                    <text wx:if="{{item.rIndex}}">签到第{{item.largerIndex}}天</text>
                                </view>
                                <view style="margin-top:20rpx">{{item.enMonth}}  {{item.enWeek}}</view>
                            </view>
                            <image class="logo-icon" src="../images/logo-icon@3x.png"></image>
                        </view>
                        <view style="width:100%;height:1px;background-color:#ffffff"></view>
                        <view class="desc">{{item.dayText}}</view>
                    </view>
                </view>
            </view>
            <view class="desc-section temp3">
                <template is="information" data="{{content:item.content,dateKey:item.dateKey}}"></template>
            </view>
        </view>
    </view>
</template>
