<template name="style1Temp">
    <view class="daily-sign temp style2">
        <view class="inside-content">
            <view class="date-section">
                <view class="icon temp"></view>
                <view class="date-group">
                    <view>
                        <view class="date-section-content">
                            <view class="date-num-content">
                                <view class="new-date">{{item.month}}.{{item.day}}</view>
                                <view class="weekday">{{item.weekText}}</view>
                            </view>
                            <view class="date-detail-content">
                                <view class="left-content temp-content">{{item.chiMonth}}{{item.chiDay}}</view>
                                <view class="right-content temp-content">{{item.gYear}}属{{item.animalYear}}</view>
                            </view>
                        </view>
                        <view class="festival" wx:if="{{item.festival}}">{{item.festival}}</view>
                        <view class="tip-left" wx:if="{{item.rIndex}}">
                            <view class="tip-left" wx:if="{{item.rIndex}}">
                                <image class="reddot" src="../images/reddot_icon@2x.png"></image>
                                <text class="reddot-text">签到第{{item.largerIndex}}天</text>
                                <image class="reddot" src="../images/reddot_icon@2x.png"></image>
                            </view>
                        </view>
                    </view>
                </view>
                <view class="{{item.festival?'words festival-sign':'words sign'}}" wx:if="{{item.rIndex}}">
                    <view class="desc temp">{{item.dayText}}</view>
                </view>
                <view class="{{item.festival?'words festival':'words'}}" wx:else>
                    <view class="desc temp">{{item.dayText}}</view>
                </view>
            </view>
            <view class="detali-section">
                <image src="{{item.largeImage}}"></image>
            </view>
            <view class="desc-section temp">
                <template is="information" data="{{content:item.content,dateKey:item.dateKey}}"></template>
            </view>
        </view>
    </view>
</template>
