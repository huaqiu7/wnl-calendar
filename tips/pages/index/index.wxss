}

.next_select_icon {
    background-image: url("https://qiniu.image.cq-wnl.com/content/20180910fd9b6ba1a6bc45e3882dc47ad02d4de9.png");
}

.next_select_txt,.prev_select_txt {
    font-size: 17px;
    color: #fff;
    text-shadow: 0 1px 1px rgba(0,0,0,.4);
