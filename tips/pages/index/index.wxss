@media screen and (max-height:420px) {
    .jieqi_list {
        margin-top: -196px;
    }

    .jieqi_year {
        padding-top: 6px;
        padding-bottom: 3px;
    }

    .jieqi_content {
        margin-top: 6px;
    }

    .jieqiLine {
